{
  "name": "tevel-tribe-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tevel tribe data engine and balance dashboard",
  "scripts": {
    "start": "node applet/launch.js",
    "applet": "node applet/launch.js",
    "build:data": "node scripts/build-dashboard-data.js",
    "build:netlify": "node scripts/prepare-netlify.js",
    "balance:median": "node scripts/compute-median-tribe.js && node scripts/build-dashboard-data.js",
    "balance:roles": "node scripts/audit-troop-roles.js",
    "balance:roles:demo": "node scripts/audit-troop-roles.js --demo-archetypes",
    "tribe:add": "node scripts/add-tribe.js",
    "tribe:list": "node scripts/add-tribe.js --list",
    "tribe:list-registered": "node scripts/add-tribe.js --list-tribes",
    "tribe:delete": "node scripts/add-tribe.js --delete",
    "tribe:regen-custom": "node scripts/regenerate-custom-tribes.js",
    "tribe:refresh-siege-logos": "node scripts/refresh-siege-logos.js",
    "dashboard": "npm run start"
  }
}
